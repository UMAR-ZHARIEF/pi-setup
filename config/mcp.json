{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--caps=pdf,testing,network,storage,devtools"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${BRAVE_PATH}"
      }
    },
    "playwright2": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--caps=pdf,testing,network,storage,devtools"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${BRAVE_PATH}"
      }
    },
    "playwright3": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--caps=pdf,testing,network,storage,devtools"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${BRAVE_PATH}"
      }
    },
    "playwright4": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--caps=pdf,testing,network,storage,devtools"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${BRAVE_PATH}"
      }
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests"
      }
    }
  }
}
